# =============================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB — Get free at https://mongodb.com/atlas
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/online-subscription

# JWT Secret — Any random long string
JWT_SECRET=your_super_secret_jwt_key_change_this_12345

# Razorpay — Get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXX

# Email (Gmail SMTP) — For sending credentials to customers
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Your WhatsApp number for support
WHATSAPP_NUMBER=918409081014

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
